[Unit]
Description=Set cgroup v2 uclamp.min=35%% on app.slice for Snapdragon 870 big-core preference
After=default.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'p=/sys/fs/cgroup/user.slice/user-%U.slice/user@%U.service/app.slice/cpu.uclamp.min; [ -w "$p" ] && echo 35 > "$p" || exit 0'
RemainAfterExit=yes

[Install]
WantedBy=default.target
