# Linux 6.18 Kconfig fragment for Xiaomi Mi Pad 5 Pro (xiaomi-elish / SM8250-AC)
# Apply on top of stock Armbian sm8250 6.18 .config:
#   ./scripts/kconfig/merge_config.sh -m .config sm8250-elish-scx.fragment && make olddefconfig

CONFIG_LOCALVERSION="-scx-sm8250"

# Full preemption + 1000 Hz tick for 2560x1600@120Hz desktop responsiveness
# CONFIG_PREEMPT_NONE is not set
CONFIG_PREEMPT=y
CONFIG_PREEMPT_DYNAMIC=y
# CONFIG_HZ_250 is not set
CONFIG_HZ_1000=y
CONFIG_HZ=1000

# sched_ext BPF schedulers (scx_cosmos) + utilization clamping + BTF
CONFIG_SCHED_CLASS_EXT=y
CONFIG_EXT_GROUP_SCHED=y
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
CONFIG_UCLAMP_BUCKETS_COUNT=5
# CONFIG_RT_GROUP_SCHED is not set
CONFIG_KALLSYMS_ALL=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
# CONFIG_DEBUG_INFO_DWARF5 is not set
CONFIG_DEBUG_INFO_BTF=y
# CONFIG_DEBUG_INFO_BTF_MODULES is not set

# Trim server bloat for 8-core ARM64 tablet + mobile-friendly cpuidle/cpufreq
CONFIG_NR_CPUS=8
# CONFIG_NUMA is not set
# CONFIG_ACPI_DEBUG is not set
# CONFIG_FW_LOADER_DEBUG is not set
# CONFIG_RCU_TRACE is not set
CONFIG_CPU_IDLE_GOV_TEO=y
# CONFIG_CPU_FREQ_DEFAULT_GOV_CONSERVATIVE is not set
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y

# Memory: MGLRU + THP madvise + multi-comp ZRAM (LZ4 active / ZSTD idle) + userfaultfd
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_LRU_GEN_WALKS_MMU=y
# CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS is not set
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
CONFIG_ZRAM_MULTI_COMP=y
CONFIG_USERFAULTFD=y

# Block I/O & Filesystems (AppImage/Snap SquashFS multi-CPU, NAS, USB UAS, Android binder)
CONFIG_BLK_WBT=y
CONFIG_BLK_WBT_MQ=y
CONFIG_IOSCHED_BFQ=m
CONFIG_BFQ_GROUP_IOSCHED=y
# CONFIG_SQUASHFS_DECOMP_SINGLE is not set
CONFIG_SQUASHFS_DECOMP_MULTI_PERCPU=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_LZO=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_NTFS3_FS=m
CONFIG_NTFS3_FS_POSIX_ACL=y
CONFIG_USB_UAS=m
CONFIG_ANDROID_BINDERFS=y
CONFIG_NETFS_SUPPORT=y
CONFIG_FSCACHE=y
CONFIG_CACHEFILES=m
CONFIG_NFS_FSCACHE=y
CONFIG_NFS_V4_2_READ_PLUS=y
CONFIG_NFSD=m
CONFIG_NFSD_V3_ACL=y
CONFIG_NFSD_V4=y
CONFIG_CIFS=m
CONFIG_CIFS_XATTR=y
CONFIG_CIFS_POSIX=y
CONFIG_CIFS_DFS_UPCALL=y
CONFIG_CIFS_FSCACHE=y
CONFIG_CIFS_COMPRESSION=y

# Networking (BBR + FQ default + CAKE) & Bluetooth profiles
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_CAKE=m
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ=y
CONFIG_BT_RFCOMM=m
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=m
